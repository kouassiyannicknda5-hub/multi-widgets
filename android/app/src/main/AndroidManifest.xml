<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Superpositions : barre latérale, sous-titres, fenêtres de traduction.
         Demandées à l'exécution, avec explication, jamais implicites. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".MultiWidgetsApp"
        android:icon="@mipmap/ic_launcher"
        android:label="Multi-widgets"
        android:theme="@android:style/Theme.Material.Light.NoActionBar"
        android:allowBackup="false">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Capture d'écran : service au premier plan de type mediaProjection,
             démarré UNIQUEMENT après consentement système (Android 14+). -->
        <service
            android:name="app.multiwidgets.ai.capture.ScreenCaptureService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <!-- Sous-titres et traduction flottants -->
        <service
            android:name="app.multiwidgets.ai.subtitles.SubtitleOverlayService"
            android:exported="false" />

    </application>
</manifest>
